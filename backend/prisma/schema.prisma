generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum UnidadMedida {
  UNIDAD
  GRAMO
}

enum EstadoVenta {
  PAGADA
  PENDIENTE
}

enum EstadoDeuda {
  PENDIENTE
  PARCIAL
  PAGADA
}

// =========================
// MODELOS
// =========================

model Negocio {
  id        String   @id @default(uuid())
  nombre    String
  direccion String?
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios    Usuario[]
  categorias  Categoria[]
  proveedores Proveedor[]
  productos   Producto[]
  inventarios Inventario[]
  clientes    Cliente[]
  ventas      Venta[]
  deudas      Deuda[]

  @@map("negocios")
}

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id           String   @id @default(uuid())
  negocioId    String
  rolId        String
  nombre       String
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  negocio Negocio @relation(fields: [negocioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])
  ventas  Venta[]

  @@index([negocioId])
  @@map("usuarios")
}

model Categoria {
  id          String  @id @default(uuid())
  negocioId   String
  nombre      String
  descripcion String?

  negocio   Negocio    @relation(fields: [negocioId], references: [id])
  productos Producto[]

  @@index([negocioId])
  @@map("categorias")
}

model Proveedor {
  id        String  @id @default(uuid())
  negocioId String
  nombre    String
  telefono  String?
  email     String?
  direccion String?

  negocio   Negocio    @relation(fields: [negocioId], references: [id])
  productos Producto[]

  @@index([negocioId])
  @@map("proveedores")
}

model Producto {
  id           String       @id @default(uuid())
  negocioId    String
  categoriaId  String
  proveedorId  String?
  nombre       String
  unidadMedida UnidadMedida
  precioVenta  Decimal      @db.Decimal(12, 2)
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  negocio       Negocio        @relation(fields: [negocioId], references: [id])
  categoria     Categoria      @relation(fields: [categoriaId], references: [id])
  proveedor     Proveedor?     @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  inventario    Inventario?
  detalleVentas DetalleVenta[]

  @@index([negocioId])
  @@index([categoriaId])
  @@map("productos")
}

model Inventario {
  id          String   @id @default(uuid())
  negocioId   String
  productoId  String   @unique
  stockActual Decimal  @db.Decimal(12, 3)
  stockMinimo Decimal? @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt

  negocio  Negocio  @relation(fields: [negocioId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([negocioId])
  @@map("inventarios")
}

model Cliente {
  id        String  @id @default(uuid())
  negocioId String
  nombre    String
  documento String?
  telefono  String?

  negocio Negocio @relation(fields: [negocioId], references: [id])
  ventas  Venta[]
  deudas  Deuda[]

  @@unique([negocioId, documento])
  @@index([negocioId])
  @@map("clientes")
}

model Venta {
  id        String      @id @default(uuid())
  negocioId String
  clienteId String
  usuarioId String
  fecha     DateTime    @default(now())
  total     Decimal     @db.Decimal(12, 2)
  estado    EstadoVenta @default(PAGADA)
  createdAt DateTime    @default(now())

  negocio  Negocio        @relation(fields: [negocioId], references: [id])
  cliente  Cliente        @relation(fields: [clienteId], references: [id])
  usuario  Usuario        @relation(fields: [usuarioId], references: [id])
  detalles DetalleVenta[]
  deuda    Deuda?

  @@index([negocioId, fecha])
  @@index([clienteId])
  @@map("ventas")
}

model DetalleVenta {
  id             String  @id @default(uuid())
  ventaId        String
  productoId     String
  cantidad       Decimal @db.Decimal(12, 3)
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId])
  @@index([productoId])
  @@map("detalle_ventas")
}

model Deuda {
  id             String      @id @default(uuid())
  negocioId      String
  clienteId      String
  ventaId        String      @unique
  monto          Decimal     @db.Decimal(12, 2)
  saldoPendiente Decimal     @db.Decimal(12, 2)
  estado         EstadoDeuda @default(PENDIENTE)
  fechaLimite    DateTime?
  createdAt      DateTime    @default(now())

  negocio Negocio @relation(fields: [negocioId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])
  venta   Venta   @relation(fields: [ventaId], references: [id])

  @@index([negocioId, estado])
  @@map("deudas")
}
