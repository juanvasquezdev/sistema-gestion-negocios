# Cadena de conexion a PostgreSQL (usada por Prisma, ver schema.prisma)
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db?schema=public"

# Secreto para firmar JWT. Requerido, sin valor por defecto (falla el arranque si falta).
JWT_SECRET=

# Tiempo de expiracion del JWT. Opcional, default "2h" si no se define.
JWT_EXPIRES_IN=2h

# "development" o "production". Controla flags de cookies (secure, sameSite).
NODE_ENV=development

# Puerto donde escucha el backend. Opcional, default 3000 si no se define.
PORT=3000
